# Local Ollama — everything on your machine. Proven working; no token, offline.
# Copy to .env:  cp .env.local.example .env
#
# In Docker use host.docker.internal (docker-compose.yml already maps it);
# running the binary directly on the host, use localhost instead.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama

# Models you have pulled in Ollama. qwen2.5:7b-instruct is the accuracy/speed
# sweet spot for menu extraction; llama3.2 is fine (and fast) for suggestions.
CHAT_MODEL=llama3.2
EXTRACT_MODEL=qwen2.5:7b-instruct
VISION_MODEL=
EMBEDDING_MODEL=nomic-embed-text

# Ollama's nomic build often adds the task prefixes itself; leave these blank
# first. If retrieval looks poor, set them (adding them twice also hurts):
#   EMBED_QUERY_PREFIX="search_query: "
#   EMBED_DOCUMENT_PREFIX="search_document: "
EMBED_QUERY_PREFIX=
EMBED_DOCUMENT_PREFIX=

# Embeddings share the endpoint above; leave these blank.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

DB_PATH=data/mealplanner.db
PORT=8080
OUTPUT_LANG=ca
SEASON_WEIGHT=0.15
REQUEST_TIMEOUT=300

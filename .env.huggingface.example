# Hugging Face Inference Providers (router) — chat + embeddings on one /v1 base.
# Copy to .env:  cp .env.huggingface.example .env   (then set your token)
#
# IMPORTANT: the base URL MUST end in /v1 (https://router.huggingface.co/v1).
# https://huggingface.co is the website, not an API — it returns HTML and fails.
OPENAI_BASE_URL=https://router.huggingface.co/v1
OPENAI_API_KEY=hf_your_token_here

# Models are HF repo ids (chat/extraction).
CHAT_MODEL=google/gemma-3-12b-it
EXTRACT_MODEL=google/gemma-3-12b-it
VISION_MODEL=google/gemma-3-12b-it

# Embeddings via HF's feature-extraction API (the HF router has no OpenAI
# /v1/embeddings route). EMBEDDING_PROVIDER=hf switches to it. Base defaults to
# https://router.huggingface.co/hf-inference and the HF token is reused from
# OPENAI_API_KEY, so you normally only set the model.
# NOTE: the model must be served by hf-inference. Verified working (2026-07):
#   intfloat/multilingual-e5-base   (768 dims — good Catalan/Spanish, recommended)
#   intfloat/multilingual-e5-large  (1024 dims — better, slower)
#   BAAI/bge-m3                     (1024 dims)
# nomic-ai/nomic-embed-text-v1.5 is NOT served ("Model not supported").
EMBEDDING_PROVIDER=hf
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# E5 models require these task prefixes (trailing space is significant; quotes
# preserve it). Without them, retrieval quality degrades.
EMBED_QUERY_PREFIX="query: "
EMBED_DOCUMENT_PREFIX="passage: "

DB_PATH=data/mealplanner.db
PORT=8080
OUTPUT_LANG=ca
SEASON_WEIGHT=0.15
REQUEST_TIMEOUT=300

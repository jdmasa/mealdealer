# OpenAI-compatible API endpoint and credentials.
# Point BASE_URL at your provider (OpenAI, a local Qwen server, vLLM, etc.).
OPENAI_BASE_URL=https://masatrad-qwen2-5-coder.hf.space/v1/
OPENAI_API_KEY=ollama

# Models.
#   CHAT_MODEL     — used for suggestions (can be small/fast).
#   EXTRACT_MODEL  — used to parse uploaded menus/PDFs into JSON; leave empty to
#                    reuse CHAT_MODEL. Set a stronger model here (e.g. a 7B-12B
#                    instruct model) for accurate monthly-PDF extraction.
#   VISION_MODEL   — used for image uploads; leave empty to reuse CHAT_MODEL
#                    (must be multimodal to actually read images).
CHAT_MODEL=gemma3:12b
EXTRACT_MODEL=gemma3:12b
VISION_MODEL=
EMBEDDING_MODEL=nomic-embed-text

# Storage and server.
DB_PATH=data/mealplanner.db
PORT=8080

# UI + suggestion default language: ca (Catalan) or es (Spanish).
OUTPUT_LANG=ca

# How strongly seasonality (target month vs. historical month) influences
# retrieval ranking, blended with lunch similarity. 0 disables it.
SEASON_WEIGHT=0.15

# HTTP read/write timeout in seconds. Local LLMs (Ollama) can be slow on large
# inputs like a monthly menu PDF, so keep this generous.
REQUEST_TIMEOUT=300
